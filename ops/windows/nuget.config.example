<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Replace with the company NuGet proxy or mirror. Do not add credentials to this file. -->
    <add key="company-nuget" value="https://nuget.company.example/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="company-nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
